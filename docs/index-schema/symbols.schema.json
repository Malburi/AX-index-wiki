{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "symbols.json",
  "type": "object",
  "required": ["_meta", "symbols"],
  "properties": {
    "_meta": { "$ref": "_meta.schema.json" },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "file", "line"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": ["integer", "null"] },
          "package": { "type": "string" },
          "extends": { "type": "string" },
          "implements": { "type": "array", "items": { "type": "string" } },
          "annotations": { "type": "array", "items": { "type": "string" } },
          "workspace": { "type": "string" },
          "origin": { "type": "string", "enum": ["deterministic-indexer", "analyzer-fallback"] },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "methods": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "id", "line"],
              "properties": {
                "name": { "type": "string" },
                "id": { "type": "string" },
                "line": { "type": ["integer", "null"] },
                "visibility": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
